{
	"schemaVersion": 1,
	"id": "recipesdelight",
	"version": "${version}",
	"name": "Recipes Delight",
	"description": "Cooking Pot recipes as craftable using ingredients stored in nearby chests and containers.",
	"authors": [
		"SNR"
	],
	"contact": {
		"sources": "https://github.com/snrcloud/recipes-delight"
	},
	"license": "MIT",
	"icon": "assets/recipesdelight/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fr.snrcloud.recipesdelight.RecipesDelightMod"
		],
		"client": [
			"fr.snrcloud.recipesdelight.client.RecipesDelightModClient"
		],
		"modmenu": [
			"fr.snrcloud.recipesdelight.client.RecipesDelightModMenuIntegration"
		]
	},
	"mixins": [
		"recipesdelight.mixins.json",
		{
			"config": "recipesdelight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"farmersdelight": ">=3.6.0",
		"cloth-config": "*",
		"modmenu": "*"
	},
	"suggests": {
		"ecologics": "*"
	}
}
